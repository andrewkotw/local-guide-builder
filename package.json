{
  "name": "local-guide-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "check:dist": "node scripts/check-dist.mjs",
    "test:production": "node scripts/check-production.mjs",
    "lint": "eslint .",
    "test": "vitest run && node --test scripts/build-class-index/index.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:class-index": "node scripts/build-class-index/index.mjs",
    "test:class-index": "node --test scripts/build-class-index/index.test.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "postcss": "^8.5.29",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  }
}
